# Copy this file to .env and fill in your keys

# LLM provider — using Groq by default (free tier, swap to OpenAI if you prefer, see graph.py)
GROQ_API_KEY=gsk_...

# OPENAI_API_KEY=sk-...   # only needed if you switch get_llm() back to OpenAI

# Web search fallback — free tier gives 1,000 queries/month
TAVILY_API_KEY=tvly-...
